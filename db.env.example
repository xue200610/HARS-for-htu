# ============================================================
#  数据库配置示例
#
#  用法：把本文件复制成 db.env，填上你自己的 MySQL 密码。
#        db.env 已被 .gitignore 排除，不会上传到 GitHub。
#        HARS.bat 启动时会自动读取同目录下的 db.env。
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=改成你的MySQL密码
DB_NAME=hospital_db